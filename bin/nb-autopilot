#!/bin/bash
# nb-autopilot: switch the needs-you autopilot on and off, and read its report.
#
# While it is on, a Claude Code session that asks the owner a question is told
# to take its own recommended answer and carry on (see hooks/needs-you.sh).
# Logins, payments, merges, publishing, deletions and permission prompts wait.
#
#   nb-autopilot on [HH:MM]   all sessions, until the next HH:MM, local time (default 08:00)
#   nb-autopilot off
#   nb-autopilot session on|off SESSION_ID [TITLE]
#                             one session, until it is switched off (the
#                             needs-you window's checkbox calls this)
#   nb-autopilot status
#   nb-autopilot report       decisions since it was last switched on
#   nb-autopilot doctor       check what the window and the autopilot need on
#                             this system (macOS, Linux or Windows)
set -u
PATH="$PATH:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin"
ROOT="$(cd "$(dirname "${0//\\//}")/.." && pwd)"
# shellcheck source=hooks/platform.sh
. "$ROOT/hooks/platform.sh"
# Settings from ~/.claude/needs-you/settings.json, the same as the hook reads.
# shellcheck source=hooks/settings.sh
command -v jq >/dev/null 2>&1 && . "$ROOT/hooks/settings.sh"
DATA="$HOME/.claude/needs-you"
STATE_FILE="$DATA/autopilot.json"
LOG="$DATA/decisions.jsonl"

jq_hint() {
  case "$NY_OS" in
    macos) echo "brew install jq (macOS 15 and later include it)" ;;
    windows) echo "winget install jqlang.jq, then open a new Git Bash" ;;
    *) echo "sudo apt install jq, sudo dnf install jq or sudo pacman -S jq" ;;
  esac
}
if [ "${1:-}" != doctor ] && ! type -P jq >/dev/null 2>&1; then
  echo "nb-autopilot: jq is required ($(jq_hint))" >&2
  exit 1
fi
now=$(date +%s)
saved() { jq -r "$1 // empty" "$STATE_FILE" 2>/dev/null; }
# On means: an end time in the future and at most a day away (as in the hook).
active() {
  local until
  until=$(saved .until_epoch)
  [ "${until:-0}" -gt "$now" ] 2>/dev/null && [ "$(( until - now ))" -le 86400 ]
}
cannot_write() { echo "nb-autopilot: could not write $STATE_FILE" >&2; exit 1; }
# Apply a jq filter to the state file (an empty object when there is none).
# Every writer (this command and the window's switches) takes the same lock
# (ny_lock) and has its own temp file, so no change is lost or undone. Without the
# lock nothing is written and the call fails.
update() {
  local lock="$STATE_FILE.lock" tmp cur='{}' ok=1
  mkdir -p "$DATA" 2>/dev/null
  ny_lock "$lock" 50 0.1 || return 1
  [ -s "$STATE_FILE" ] && cur=$(cat "$STATE_FILE" 2>/dev/null)
  tmp=$(mktemp "$DATA/.autopilot.XXXXXX" 2>/dev/null) &&
    printf '%s' "$cur" | jq "$@" > "$tmp" 2>/dev/null && mv "$tmp" "$STATE_FILE" 2>/dev/null && ok=0
  [ -n "${tmp:-}" ] && rm -f "$tmp" 2>/dev/null
  ny_unlock "$lock"
  # The inbox page (Linux, Windows) shows the autopilot state: refresh it.
  if [ "$ok" = 0 ] && [ -f "$DATA/web/index.html" ]; then
    ( "$ROOT/bin/needs-you-window" --refresh </dev/null >/dev/null 2>&1 & )
  fi
  return "$ok"
}

case "${1:-status}" in
  on)
    hhmm="${2:-08:00}"
    if ! [[ "$hhmm" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
      echo "nb-autopilot: give the end time as HH:MM, for example 08:00" >&2
      exit 2
    fi
    today=$(date +%Y-%m-%d)
    until=$(ny_epoch_of "$today $hhmm:00") || exit 1
    if [ "$until" -le "$now" ]; then
      # Tomorrow's date: noon today plus a day is tomorrow, also across a
      # change to or from summer time.
      noon=$(ny_epoch_of "$today 12:00:00") || exit 1
      until=$(ny_epoch_of "$(ny_date_at $(( noon + 86400 )) %Y-%m-%d) $hhmm:00") || exit 1
    fi
    # Switching on again while it runs keeps the start, so the report stays whole.
    # Decided under the lock, from the state as it is at that moment.
    label=$(ny_date_at "$until" '%Y-%m-%d %H:%M')
    update --argjson u "$until" --argjson n "$now" --arg h "$label" '
      (((.until_epoch // 0) > $n) and ((.until_epoch // 0) - $n <= 86400)) as $running
      | .since_epoch = (if $running then (.since_epoch // $n) else $n end)
      | .until_epoch = $u | .until = $h' || cannot_write
    echo "Autopilot ON until $label"
    ;;
  off)
    # Keeps the start time for the report and the per-session switches.
    if [ -f "$STATE_FILE" ]; then
      update --argjson n "$now" '.until_epoch = $n' || cannot_write
      if active; then cannot_write; fi
    fi
    echo "Autopilot OFF"
    ;;
  session)
    sid="${3:-}"
    if ! [[ "$sid" =~ ^[A-Za-z0-9_.-]+$ ]] || { [ "${2:-}" != on ] && [ "${2:-}" != off ]; }; then
      echo "usage: nb-autopilot session on|off SESSION_ID [TITLE]" >&2
      exit 2
    fi
    if [ "$2" = on ]; then
      # Each tick opens a period and each untick closes it; all periods are kept,
      # so the morning report has every decision taken for this session. A
      # period open for a day has already ended (the hook stops at a day): it
      # is closed at that time and a new one opens.
      update --arg id "$sid" --arg t "${4:-}" --argjson n "$now" '
        .sessions[$id] = ((.sessions[$id] // {}) | .title = (if $t != "" then $t else (.title // "") end)
          | .periods = ((.periods // [])
              | if length > 0 and .[-1][1] == null and ($n - (.[-1][0] // 0)) >= 86400
                then .[-1][1] = (.[-1][0] + 86400) else . end
              | if length > 0 and .[-1][1] == null then . else . + [[$n, null]] end))' \
        || cannot_write
      echo "Autopilot ON for ${4:-$sid}"
    else
      update --arg id "$sid" --argjson n "$now" '
        if .sessions[$id] then .sessions[$id].periods |= ((. // [])
          | if length > 0 and .[-1][1] == null then .[-1][1] = $n else . end) else . end' || cannot_write
      echo "Autopilot OFF for ${4:-$sid}"
    fi
    ;;
  status)
    if active; then echo "Autopilot ON until $(saved .until)"; else echo "Autopilot OFF"; fi
    jq -r --argjson n "$(date +%s)" '(.sessions // {}) | to_entries[]
      | select(.value | ((.periods // []) | length > 0 and .[-1][1] == null and ($n - (.[-1][0] // 0)) < 86400))
      | "  on for \(.value.title // .key) (\(.key))"' "$STATE_FILE" 2>/dev/null
    ;;
  report)
    # Since autopilot for all sessions was last switched on, plus the decisions
    # of each session that had its own autopilot, while it was ticked.
    since=$(saved .since_epoch)
    own=$(jq -c '(.sessions // {}) | map_values(.periods // [])' "$STATE_FILE" 2>/dev/null)
    [ -n "$own" ] || own='{}'
    lines=""
    [ -s "$LOG" ] && lines=$(jq -r --argjson s "${since:-$((now + 1))}" --argjson own "$own" \
      'select(.ts as $t | $t >= $s or any(($own[.session] // [])[]; $t >= .[0] and $t <= (.[1] // $t)))
       | "\(.time)  \(.title)  \(.decision)"' "$LOG" 2>/dev/null)
    if [ -n "$lines" ]; then printf '%s\n' "$lines"; else echo "No autopilot decisions."; fi
    ;;
  doctor)
    # What this system needs, with an install hint per system.
    row() { printf '%-9s%s\n' "$1" "$2"; }
    have() { type -P "$1" >/dev/null 2>&1; }   # a program, not a shell function
    row system "$NY_OS ($(uname -s 2>/dev/null))"
    if have jq; then row ok "jq"; else row MISSING "jq (required: $(jq_hint))"; fi
    case "$NY_OS" in
      macos)
        if have osascript; then row ok "osascript"; else row MISSING "osascript (the dialog; part of macOS)"; fi
        if "$ROOT/bin/needs-you-window" --check; then row ok "needs-you window (Swift)"
        else row optional "needs-you window (needs the Swift compiler: xcode-select --install)"; fi
        if have terminal-notifier; then
          row ok "terminal-notifier"
          echo "         if no banner shows, allow terminal-notifier in System Settings -> Notifications"
        else row optional "terminal-notifier (a banner when the window cannot be built: brew install terminal-notifier)"; fi ;;
      linux|other)
        if "$ROOT/bin/needs-you-window" --check; then row ok "inbox page in the browser ($(ny_opener))"
        else row optional "inbox page in the browser (needs xdg-open: sudo apt install xdg-utils)"; fi
        if have notify-send; then row ok "notify-send"
        else row optional "notify-send (notifications: sudo apt install libnotify-bin, or dnf install libnotify)"; fi ;;
      windows)
        if "$ROOT/bin/needs-you-window" --check; then row ok "inbox page in the browser (explorer.exe)"
        else row MISSING "inbox page in the browser (explorer.exe not found)"; fi
        if have powershell.exe || have pwsh || [ -n "${NEEDS_YOU_POWERSHELL:-}" ]; then row ok "PowerShell (notifications, idle time)"
        else row MISSING "PowerShell (notifications and idle time; part of Windows)"; fi ;;
    esac
    # Autopilot answers only while the owner is away, so it must read the idle time.
    minutes=$(ny_int "${NEEDS_YOU_AUTOPILOT_IDLE_MINUTES:-5}" 5)
    if ny_idle_seconds >/dev/null; then
      row ok "idle time: $NY_IDLE s since the last input ($NY_IDLE_VIA)"
    elif [ "$minutes" = 0 ]; then
      row note "idle time unknown; NEEDS_YOU_AUTOPILOT_IDLE_MINUTES=0, so autopilot answers at once"
    else
      row UNKNOWN "idle time cannot be read here: autopilot will NOT answer (it treats you as present)"
      case "$NY_OS" in
        linux|other) echo "         X11: sudo apt install xprintidle; Wayland: GNOME only (gdbus, Mutter IdleMonitor);"
                     echo "         elsewhere set NEEDS_YOU_IDLE_SECONDS_CMD, or NEEDS_YOU_AUTOPILOT_IDLE_MINUTES=0 to answer at once" ;;
        windows) echo "         needs powershell.exe in a desktop session; or set NEEDS_YOU_AUTOPILOT_IDLE_MINUTES=0" ;;
        macos) echo "         ioreg did not answer; or set NEEDS_YOU_AUTOPILOT_IDLE_MINUTES=0" ;;
      esac
    fi
    if have jq && active; then
      echo "autopilot ON until $(saved .until)"
    else
      echo "autopilot OFF"
    fi
    echo "data     $DATA"
    echo "app data $(ny_app_dir)"
    ;;
  *)
    echo "usage: nb-autopilot on [HH:MM] | off | session on|off ID [TITLE] | status | report | doctor" >&2
    exit 2
    ;;
esac
